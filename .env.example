GOOGLE_CLIENT_ID="135673746790-2quan9eadpgj4m3bsu47is9g2bqhuffq.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET=""

# Canonical public application origin used in email links. Production must set
# this to the deployed HTTPS origin. SITE_URL remains a fallback.
APP_URL=http://localhost:3000

# PostHog project token. Browser events use the managed t.tiimi.cz proxy;
# server-side events are sent directly to PostHog's EU ingestion endpoint.
NEXT_PUBLIC_POSTHOG_KEY=

# Optional production-build credentials for PostHog source-map uploads.
# Source maps are disabled when either credential is missing.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://eu.posthog.com

# Perplexity — book enrichment. Set a hard spend limit on the Perplexity account:
# it is the only control that actually bounds spend (see the add-book design doc).
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro
