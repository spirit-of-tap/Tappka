{
  "private": true,
  "scripts": {
    "dev": "run-s ensure-env supabase:start wait-2s dev:parallel",
    "ensure-env": "node scripts/package-json-helpers/ensure-env.js",
    "supabase:start": "node scripts/package-json-helpers/supabase-start.js",
    "wait-2s": "node scripts/package-json-helpers/wait-2s.js",
    "dev:parallel": "run-p docker:restart-auth setup-env dev:next db:export",
    "docker:restart-auth": "node scripts/package-json-helpers/restart-docker-auth.js",
    "setup-env": "node scripts/package-json-helpers/setup-env.js",
    "dev:next": "cross-env NODE_OPTIONS='--inspect' next dev",
    "stop": "pnpm supabase stop",
    "restart": "run-s stop dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project component",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:watch": "vitest --project unit",
    "build": "next build",
    "start": "next start",
    "db:migrate": "run-s db:generate supabase:start db:up db:types db:export",
    "db:force-migrate": "run-s db:generate supabase:start db:reset db:types db:export",
    "db:up": "pnpm supabase migration up",
    "db:reset": "pnpm supabase db reset",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:check-integrity": "node scripts/check-migration-integrity.mjs",
    "db:doctor": "run-s db:check-integrity db:local-check",
    "db:local-check": "node scripts/check-schema-local.mjs",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
    "db:export": "node scripts/package-json-helpers/export-db-sql.mjs",
    "cleanup:e2e": "node scripts/cleanup-e2e-data.mjs",
    "wiki": "node scripts/generate-docs-html-shims.mjs && vitepress dev docs --open",
    "wiki:doctor": "node scripts/check-docs-links.mjs"
  },
