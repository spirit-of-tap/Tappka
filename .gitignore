# env files (can opt-in for committing if needed)
.env*.local
.env
.env**
!.env.example
!
# supabase
# This file is encrypted it is safe to commit
!supabase/.env.preview  

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# git worktrees
/.worktrees/

# superpowers subagent-driven-development scratch workspace
/.superpowers/

# mise local overrides (not committed)
mise.local.toml
mise.*.local.toml

# Production data dumps — personal data, never commit
scripts/data/*_rows.sql

# Legacy CSV import — contains personal data and CSV exports
scripts/essayimport/

# Generated print sheets — regenerate on demand, don't version
scripts/output/

# Throwaway čtení launch video tooling — regenerate on demand, don't version
scripts/video-demo/

# Local data dumps, SQL exports and scratchpad files — never commit
/data/
/sql/

# Python cache & one-off migration/enrichment scripts
__pycache__/
*.py[cod]
scripts/enrich_books_from_perplexity.py
scripts/import-prod-books-essays.py
scripts/push_descriptions_to_prod.py

