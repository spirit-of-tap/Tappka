# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.tmp

# Generated local DB dumps — do not commit
db/sql

.claude
.agents

# testing
/coverage

# next.js
/.next/
/out/
.next/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnpm-store

# env files (can opt-in for committing if needed)
.env*.local
.env
.env**
!.env.example
!
# supabase
# This file is encrypted it is safe to commit
!supabase/.env.preview  

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# git worktrees
/.worktrees/

# mise local overrides (not committed)
mise.local.toml
mise.*.local.toml

# Production data dumps — personal data, never commit
scripts/data/*_rows.sql
scripts/data/*.csv

# Legacy CSV import — contains personal data and CSV exports
scripts/essayimport/

# Contact exports — names, phone numbers, birthdays, personal emails, photos
scripts/*.vcf
scripts/**/*.vcf

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# VitePress
docs/.vitepress/cache
docs/.vitepress/dist
.vitepress
